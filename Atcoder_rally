#include<bits/stdc++.h>
using namespace std;
using ll=long long;
#define endl '\n'

void f(){
    int n;
    cin>>n;
    ll sum=0;
    vector<int> v(n,0);
    for(int i=0;i<n;i++){
        cin>>v[i];
        sum+=v[i];
    }
    ll vertex_point=sum/n;
    ll vertex_point2=vertex_point+1;
    // find mimimum
    ll ans1=0,ans2=0;
    for(int i=0;i<n;i++){
        ans1+=pow((v[i]-vertex_point),2);
        ans2+=pow((v[i]-vertex_point2),2);
    }
    cout<<min(ans1,ans2)<<endl;
        return ;
}
int main(){
ios_base::sync_with_stdio(false);
cin.tie(NULL);
int t=1;
// cin>>t;
while(t--){
    f();
}
return 0;
}
